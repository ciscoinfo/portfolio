---
import { projects } from "../data/projects";
---
<div id="projects-section" style="position:relative; background:#FBFAF7; scroll-margin-top:24px;">
  <div class="wrap" style="padding-top:88px; padding-bottom:88px;">
    <div class="sec-title">A few things I've built</div>
    <div class="project-list">
      {projects.map((project, i) => (
        <div class="project-row">
          <div class="project-shot">
            <button
              type="button"
              class="project-shot-btn"
              data-project-index={i}
              aria-label={`View screenshots of ${project.title}`}
            >
              <span class="project-frame">
                <img src={`${import.meta.env.BASE_URL}${project.cover.slice(1)}`} alt={`${project.title} screenshot`} />
              </span>
            </button>
          </div>
          <div>
            <div class="project-idx">{String(i + 1).padStart(2, "0")}</div>
            <div class="project-title">{project.title}</div>
            <div class="project-summary">{project.summary}</div>
            <div class="project-tags">
              {project.tags.map((tag) => <span class="pr-tag-outline">{tag}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
