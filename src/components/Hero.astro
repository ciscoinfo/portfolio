---
---
<div style="position:relative; background:linear-gradient(120deg,#330867 0%, #0B6A8E 60%, #31A7BB 100%);">
  <div class="wrap hero-flex" style="padding-top:96px; padding-bottom:110px;">
    <div style="flex:1.2; min-width:0;">
      <div class="pr-tag" style="background:rgba(255,255,255,0.16); margin-bottom:24px;">PLATFORM DEVSECOPS ENGINEER</div>
      <div class="hero-headline" style="font-family:var(--font-display); font-weight:700; font-size:52px; line-height:1.1; color:#fff; letter-spacing:-0.01em;">
        Secure infrastructure.<br><span style="color:#FFB27A;">Zero disruption.</span>
      </div>
      <div style="font-size:17px; line-height:1.6; color:#E6E1F5; margin-top:22px; max-width:460px;">
        I'm François — I secure and scale developer platforms at scale, without slowing teams down.
      </div>
      <div style="margin-top:32px;">
        <a href="#projects-section" class="pr-btn" style="background:#FF7A1F; color:#fff; display:inline-flex;">View projects</a>
      </div>
    </div>
    <div style="flex:0.6; display:flex; justify-content:center;">
      <div class="hero-photo" style="width:250px; height:250px; border-radius:28px; background:#fff; box-shadow:0 30px 60px -20px rgba(0,0,0,0.3); display:flex; align-items:center; justify-content:center; transform:rotate(3deg); overflow:hidden;">
        <img src={`${import.meta.env.BASE_URL}images/photo/francois.jpg`} alt="François Hugot" style="width:88%; height:88%; object-fit:cover; border-radius:20px; transform:rotate(-3deg);">
      </div>
    </div>
  </div>
</div>
