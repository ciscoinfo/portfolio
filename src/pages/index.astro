---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TrackRecord from "../components/TrackRecord.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import ProjectModal from "../components/ProjectModal.astro";
import Contact from "../components/Contact.astro";
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" sizes="48x48" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>François Hugot — Platform DevSecOps Engineer</title>
	</head>
	<body>
		<Nav />
		<Hero />
		<TrackRecord />
		<About />
		<Skills />
		<Projects />
		<ProjectModal />
		<Contact />
	</body>
</html>
